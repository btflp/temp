+	/* Parses HERE Flexible Polyline format.Reference: https://github.com/heremaps/flexible-polyline */
+    private static final String ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
+    private static final int[] DECODING_TABLE = new int[128];
+
+    static {
+        for (int i = 0; i < ALPHABET.length(); i++) {
+            DECODING_TABLE[ALPHABET.charAt(i)] = i;
+        }
+    }
+
+    // Precision levels as powers of 10
+    private static final double[] POW10 = {
+        1, 10, 100, 1000, 10000, 100000, 1000000, 10000000
+    };
+
+    /**
+     * Parses a HERE flexible polyline and returns a list of LatLon points.
+     * @param encoded The encoded flexible polyline string.
+     * @return List of LatLon points.
+     */
+    public static List<LatLon> parseflexiblePolyline(String encoded) {
+        int index = 0;
+        int length = encoded.length();
+
+        // Decode header
+        int header = decodeChar(encoded, index++);
+        int precision = header & 0x0F;
+        int thirdDim = (header >> 4) & 0x07;
+        int thirdDimPrecision = (header >> 7) & 0x0F; // usually unused
+
+        // Decode polyline
+        int lat = 0, lng = 0, z = 0;
+        List<LatLon> result = new ArrayList<>();
+        int[] lastValues = {0, 0, 0};
+        int dim = (thirdDim == 0 ? 2 : 3);
+
+        while (index < length) {
+            for (int i = 0; i < dim; i++) {
+                long value = decodeUnsignedVarint(encoded, length, new int[] {index});
+                index = globalIndex;
+                long delta = (value & 1) != 0 ? ~(value >> 1) : (value >> 1);
+                lastValues[i] += delta;
+            }
+            double latVal = lastValues[0] / POW10[precision];
+            double lngVal = lastValues[1] / POW10[precision];
+            result.add(new LatLon(latVal, lngVal));
+            // If you wish to store third dimension, use lastValues[2]
+        }
+        return result;
+    }
+	/* ---------------------------------------------------------------------------------- */
+
+    private static int globalIndex = 0;
+    private static long decodeUnsignedVarint(String encoded, int length, int[] indexArr) {
+        int value = 0;
+        int shift = 0;
+        int index = indexArr[0];
+        int b;
+        do {
+            if (index >= length) break;
+            b = DECODING_TABLE[encoded.charAt(index++)];
+            value |= (b & 0x1F) << shift;
+            shift += 5;
+        } while (b >= 0x20);
+        globalIndex = index;
+        indexArr[0] = index;
+        return value;
+    }
+
+    private static int decodeChar(String encoded, int index) {
+        return DECODING_TABLE[encoded.charAt(index)];
+    }
+
