+            case "keep-right":
+                return 7; // keep right (not standard, adjust as needed)
+            case "merge":
+            case "fork":
+            case "ramp":
+                return 11; // use slip road
+            case "take-exit":
+                return 12; // take exit
+        }
+        // If no mapping found, return unknown value
+        return Integer.MIN_VALUE;
+    }
