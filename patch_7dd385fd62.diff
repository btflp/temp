+    /**
+     * Map HERE Routing API v8 'action' and 'direction' to Graphhopper 'sign' code.
+     *
+     * @param action    The HERE maneuver action (e.g., "turn", "depart", "arrive").
+     * @param direction The HERE maneuver direction (e.g., "left", "right", "straight").
+     * @return The Graphhopper sign code, or Integer.MIN_VALUE if unknown.
+     */
+    public static int mapHereToGraphhopperSign(String action, String direction) {
+        if (action == null) return Integer.MIN_VALUE;
+
+        switch (action) {
+            case "depart":
+                return 0; // continue
+
+            case "arrive":
+                return 4; // destination reached
+
+            case "turn":
+                if ("slightLeft".equals(direction)) return -1;
+                if ("left".equals(direction)) return -2;
+                if ("sharpLeft".equals(direction)) return -3;
+                if ("slightRight".equals(direction)) return 1;
+                if ("right".equals(direction)) return 2;
+                if ("sharpRight".equals(direction)) return 3;
+                if ("straight".equals(direction)) return 0;
+                break;
+
+            case "continue":
+                return 0; // continue
+
+            case "uturn":
+                return -6; // Graphhopper: -6 = u-turn left, 6 = u-turn right
+            case "enter-roundabout":
+            case "roundabout":
+                return 6; // enter roundabout
+            case "leave-roundabout":
